# =============================================================
# VMQ Monitor V2 — 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 gitignore 排除）
# =============================================================

# --- GitHub ---
GH_TOKEN=          # github_pat_... 或 ghp_...
GH_REPO=Z010Gemleman/ios-dev-wx-alipay

# --- 设备 SSH ---
DEVICE_IP=         # Tailscale IP，如 100.76.1.103
DEVICE_IP_ALT=     # 备用 IP
DEVICE_USER=mobile
DEVICE_PASS=       # mobile 用户密码

# --- VMQ 服务端 ---
VMQ_SERVER_URL=    # 如 https://pay.example.com
VMQ_SERVER_KEY=    # VMQ 通信密钥

# --- 构建路径（WSL 内）---
THEOS_STD=/root/theos
THEOS_ROOTHIDE=/root/theos_roothide
